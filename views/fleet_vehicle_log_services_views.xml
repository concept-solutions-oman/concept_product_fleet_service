<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_service_form_inherit_move" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit.move</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group[1]" position="before">
                <div name="button_box" class="oe_button_box">
                    <button
                        name="action_open_source_bill"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not move_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Vendor Bill</span>
                            <field name="move_name" class="o_stat_value" nolabel="1"/>
                        </div>
                    </button>
                </div>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="move_id" invisible="1"/>
                <field name="move_name" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>