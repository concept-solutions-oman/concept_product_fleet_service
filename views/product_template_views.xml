<odoo>
    <record id="view_product_template_form_inherit_fleet" model="ir.ui.view">
        <field name="name">product.template.form.inherit.fleet</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Add new Fleet Management section inside the Inventory tab -->
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Fleet Management">
                    <field name="is_fleet"/>
                    <field name="service_type_id"
                           invisible="not is_fleet"
                           required="is_fleet"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
