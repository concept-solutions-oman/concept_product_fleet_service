<odoo>
    <record id="view_fleet_vehicle_form_inherit_analytic" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.analytic</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location']" position="after">
                <field name="analytic_distribution" widget="analytic_distribution" string="Analytic Distribution"/>
            </xpath>
        </field>
    </record>
    
</odoo>
