<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_fleet" model="ir.ui.view">
        <field name="name">account.move.form.inherit.fleet</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                <field name="vehicle_id" options="{'no_create': False}"/>
                <field name="is_fleet" optional="hide"/>
            </xpath>

        </field>
    </record>

    <record id="view_move_form_inherit_fleet_button" model="ir.ui.view">
        <field name="name">account.move.form.inherit.fleet.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="has_fleet_product" invisible="1"/>
                <field name="service_log_count" invisible="1"/>
            </xpath>

            <xpath expr="//sheet/group" position="inside">
                <field name="vehicle_id" options="{'no_create': False}" required="0"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_add_fleet_service"
                        string="Add Fleet Service"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'posted' or not has_fleet_product or move_type != 'in_invoice' or service_log_count > 0"/>
            </xpath>

            

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_show_fleet_services"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-car"
                        invisible="service_log_count == 0">
                    <div class="o_stat_info">
                        <field name="service_log_count" class="o_stat_value"/>
                        <span class="o_stat_text" invisible="service_log_count == 1">Fleet Services</span>
                        <span class="o_stat_text" invisible="service_log_count != 1">Fleet Service</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>
</odoo>